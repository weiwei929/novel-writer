# Novel-Writer 环境变量配置

# === AI Provider（三选一）===
# 当前使用: DeepSeek
# 通过 Settings 页面切换 provider，无需改此文件

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选: OpenAI API（取消注释即可启用）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# 可选: Ollama（本地部署，取消注释即可启用）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Prisma/SQLite 数据库路径
DATABASE_URL="file:./dev.db"

# 应用配置
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# 域名配置（生产环境）
DOMAIN=novel.pennfly.com
SERVER_URL=https://novel.pennfly.com

# 数据存储
DATA_PATH=./data
BACKUP_PATH=./data/backups
MEDIA_PATH=./data/media

# 安全配置
APP_PASSWORD=novel2024

# 文件上传限制
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=5242880

# 备份配置
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_INTERVAL=86400

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=/logs/app.log
