# Novel-Writer 环境变量配置（示例 — 复制为 .env 后填写真实值，勿提交 .env）

# === AI Provider（可选；当前 AI UI 已冻结，私人部署可不填）===
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash

# === 数据库（SQLite）===
# 本地开发（相对仓库根目录）：
DATABASE_URL="file:./backend/prisma/dev.db"
# Docker / 私人服务器生产（容器内绝对路径，对应宿主机 ./data/novel.db）：
# DATABASE_URL="file:/app/data/novel.db"

# === 服务监听 ===
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
FRONTEND_PORT=3000

# === 域名与 Caddy（Docker 部署）===
# --- 模式 A：私人 HTTP 手测（默认）---
DOMAIN=localhost
CADDYFILE=Caddyfile.http
# --- 模式 B：公网 HTTPS（切换时改以下三项）---
# DOMAIN=novel-writer.example.com
# CADDYFILE=Caddyfile.https
# HTTPS_EMAIL=admin@example.com
HTTPS_EMAIL=
SERVER_URL=http://localhost

# === 数据目录（本地开发相对路径；Docker 由 compose 覆盖为 /app/data）===
DATA_PATH=./data
BACKUP_PATH=./data/backups
MEDIA_PATH=./data/media

# === 安全（生产必须修改）===
APP_PASSWORD=change-me-to-a-strong-password

# === 可选 ===
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=5242880
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_INTERVAL=86400
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
