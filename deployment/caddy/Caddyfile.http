# HTTP 私人手测（默认）
# 用法：.env 中 CADDYFILE=Caddyfile.http，DOMAIN=localhost 或局域网 IP
# 站点仅监听 HTTP :80，不含 tls 指令

http://{$DOMAIN:localhost} {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }

    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /media/* {
        reverse_proxy backend:5000
    }

    handle /health {
        reverse_proxy backend:5000
    }

    handle /* {
        reverse_proxy frontend:3000
    }

    log {
        output file /data/access.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
