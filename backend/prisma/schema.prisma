// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Core Hierarchy (核心层级)
// ---------------------------------------------------------

model Collection {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String?
  author       String?
  coverImage   String?
  status       String   @default("draft") // draft | planning | writing | reviewing | completed | archived | shelved
  
  // Stats
  wordCount    Int      @default(0)
  
  // Flexible Metadata (For Living Guidebook / Synopsis etc.)
  metadata     Json?    // { "synopsis": "...", "outline": ... }
  
  // The "Deep Line" (暗线) - AI Guidance
  masterPrompt String?  // The distilled prompt from Socratic dialogue
  
  // Collection Management
  tags         Json?    // ["玄幻", "大女主"]
  
  
  // Relations
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  
  chapters     Chapter[]
  characters   Character[]
  locations    Location[]
  scraps       Scrap[]
  timelineEntries TimelineEntry[]
  creativeFlows   CreativeFlow[]
  proposals    Proposal[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  content   String   // Markdown content
  order     Int      // Display order
  status    String   @default("draft")
  
  wordCount Int      @default(0)
  summary   String?  // Chapter synopsis
  metadata  Json?    // JSON string for extra data
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Snapshot/History references can be added here if needed, 
  // but we primarily use Scrapbook for discarded ideas.
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// The Writer's Scrapbook (灵感剪贴簿) - Replaces Git-style Versioning
// ---------------------------------------------------------

model Scrap {
  id        String   @id @default(uuid())
  content   String
  note      String?  // User's note on why they clipped this
  tags      Json?    // JSON string or comma-separated tags
  
  // Where did this come from?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  // Optional linkage to original chapter context
  originalChapterId String?
  
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// The Living Guidebook (“活体”设定集)
// ---------------------------------------------------------

model Character {
  id          String  @id @default(uuid())
  name        String
  role        String? // Protagonist, Antagonist, Supporting
  description String?
  
  // Detailed traits stored as JSON for flexibility
  profile     Json?   // { "age": 20, "appearance": "...", "relationships": [] }

  // --- TASK-006 结构化人物设定字段（全部选填，兼容旧数据） ---
  gender       String? // 性别
  age          String? // 年龄
  identity     String? // 身份/职业
  appearance   String? // 外貌
  personality  String? // 性格（含特点/缺陷）
  interests    String? // 兴趣
  roleType     String? // 角色定位：主角一号/二号/重要配角/普通配角/龙套
  experience   String? // 个人经历（选填）
  keyRelations String? // 关键关系（选填）
  catchphrase  String? // 口头禅（选填）

  // 归属：proposalId（提案阶段）/ projectId（立项后），应用层强制二选一
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId  String?
  proposal    Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          String  @id @default(uuid())
  name        String
  description String?
  
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Story Timeline (故事线) - TASK-006
// ---------------------------------------------------------

model TimelineEntry {
  id            String  @id @default(uuid())
  time          String  // 时间标记（必填）
  location      String  // 地点（必填）
  characters    String  // 涉及人物及当下关系（必填）
  premise       String? // 起因（选填）
  process       String? // 过程（选填）
  outcome       String? // 结果（选填）
  narrativeMode String? // 叙事方式（选填）
  emotionStage  String? // 情绪阶段（选填）
  notes         String? // 备注（选填）
  sortOrder     Int     // 排序

  // 归属：proposalId（提案阶段）/ projectId（立项后），应用层强制二选一
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Creative Flow (创作心流) - TASK-006
// ---------------------------------------------------------

model CreativeFlow {
  id      String @id @default(uuid())
  title   String
  content String // Markdown
  tags    Json?  // 标签

  // 归属：proposalId（提案阶段）/ projectId（立项后），应用层强制二选一
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Proposal (企划建议书) - TASK-008
// ---------------------------------------------------------

// ---------------------------------------------------------
// External File Reference (外来参考) - TASK-101
// ---------------------------------------------------------

model FileReference {
  id              String   @id @default(uuid())
  fileName        String
  fileContent     String?
  fileType        String   @default("md")
  sourceUrl       String?
  processingType  String   @default("none") // complete | partial | none (Type 1/2/3)
  proposalId      String?
  annotations     Json?
  comment         String?
  tags            Json?
  metadata        Json?    // { title, paragraphs, paragraphCount }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Proposal {
  id          String   @id @default(uuid())
  title       String
  synopsis    String?  // 故事梗概
  innovation  String?  // 创新点
  coreSetting String?  // 核心设定（高层自由描述）
  status      String   @default("draft") // draft | submitted | evaluated | approved | rejected | shelved
  references  Json?    // 外来参考/碎片ID列表（UI 轻处理）
  sourceNotes String?  // 来源讨论记录

  projectId   String?  // 立项后关联项目
  project     Project? @relation(fields: [projectId], references: [id])

  characters      Character[]
  timelineEntries TimelineEntry[]
  creativeFlows   CreativeFlow[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
