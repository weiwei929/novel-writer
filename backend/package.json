    "dev": "nodemon --config nodemon.json --exec ts-node src/index.ts",
    "generate": "node -e \"require('dotenv').config({path:'.env.example'}); require('child_process').execSync('npx prisma generate',{stdio:'inherit',env:process.env})\"",
