# Backend 环境变量（本地开发 — 复制为 backend/.env）

# 监听：本地默认仅本机；Docker compose 会注入 HOST=0.0.0.0
PORT=5000
HOST=127.0.0.1

# 数据库路径相对 backend/prisma/schema.prisma 所在目录
# 开发库真源：backend/prisma/dev.db
DATABASE_URL="file:./dev.db"
# 或使用统一 data 目录（与生产布局一致）：
# DATABASE_URL="file:../../data/novel.db"

# 安全（生产必须设置强密码）
APP_PASSWORD=change-me-to-a-strong-password

LOG_LEVEL=info
